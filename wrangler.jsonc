{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "breezy-travels",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "alias": {
    "#tanstack-router-entry": "./dist/server/assets/router-Di4NrLPR.js",
    "#tanstack-start-entry": "./dist/server/assets/start-BFFNhTMt.js",
    "tanstack-start-manifest:v": "./dist/server/assets/_tanstack-start-manifest_v-CqH9q-tD.js"
  },
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1",
        "simple": {
          "limit": 20,
          "period": 60
        }
      }
    ]
  },
  "env": {
    "preview": {
      "name": "breezy-travels-preview"
    }
  }
}
// rebuild
